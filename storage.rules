rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.isAdmin == true;
    }

    function validProfilePhoto() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('image/.*');
    }

    function chatExists(chatId) {
      return firestore.exists(
        /databases/(default)/documents/chats/$(chatId)
      );
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && chatExists(chatId)
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.participants;
    }

    function validDeterministicChatId(senderId, receiverId, chatId) {
      return receiverId is string
        && receiverId != senderId
        && (
          (
            senderId < receiverId
            && chatId == senderId + '_' + receiverId
          )
          || (
            receiverId < senderId
            && chatId == receiverId + '_' + senderId
          )
        );
    }

    function validPrivateChatMedia(senderId, chatId, messageId) {
      let metadata = request.resource.metadata;
      return request.resource != null
        && request.resource.size > 0
        && request.resource.contentType is string
        && metadata.senderId == senderId
        && metadata.chatId == chatId
        && metadata.messageId == messageId
        && validDeterministicChatId(senderId, metadata.receiverId, chatId)
        && (
          (
            metadata.mediaType == 'image'
            && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
          )
          || (
            metadata.mediaType == 'video'
            && request.resource.size <= 30 * 1024 * 1024
            && request.resource.contentType == 'video/mp4'
          )
          || (
            metadata.mediaType == 'voice'
            && request.resource.size <= 8 * 1024 * 1024
            && request.resource.contentType.matches('audio/(mp4|m4a|aac)')
          )
        );
    }

    function validAnnouncementMedia(announcementId) {
      let metadata = request.resource.metadata;
      return request.resource != null
        && request.resource.size > 0
        && request.resource.contentType is string
        && metadata.adminId == request.auth.uid
        && metadata.announcementId == announcementId
        && (
          (
            metadata.mediaType == 'image'
            && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
          )
          || (
            metadata.mediaType == 'video'
            && request.resource.size <= 30 * 1024 * 1024
            && request.resource.contentType == 'video/mp4'
          )
          || (
            metadata.mediaType == 'voice'
            && request.resource.size <= 8 * 1024 * 1024
            && request.resource.contentType.matches('audio/(mp4|m4a|aac)')
          )
        );
    }

    match /profile_photos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if owns(uid) && validProfilePhoto();
      allow delete: if owns(uid);
    }

    match /privateChatMedia/{senderId}/{chatId}/{messageId}/{fileName} {
      allow read: if owns(senderId) || isChatParticipant(chatId);
      allow create: if owns(senderId)
        && validPrivateChatMedia(senderId, chatId, messageId);
      allow update: if false;
      allow delete: if owns(senderId);
    }

    match /announcementMedia/{announcementId}/{fileName} {
      allow read: if signedIn();
      allow create: if isAdmin() && validAnnouncementMedia(announcementId);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
